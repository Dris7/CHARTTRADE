# Optional. Without a key the FRED CSV gateway (`fredgraph.csv`) is used and
# covers everything the dashboard needs. With a key, the JSON API is used,
# which has higher rate limits.
FRED_API_KEY=""

# Optional. Enables the Google Gemini "AI synthesis" polish on the Daily Macro
# Brief. Create a key at https://aistudio.google.com. Without it the brief falls
# back to the deterministic rule-based synthesis (no key required).
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-flash-latest).
GEMINI_MODEL=""
